# hilinkd configuration, for the Docker and bare-metal installs.
# Copy to .env and edit. Everything here is optional: with an empty file the
# service autodetects the router, generates an admin password and prints it once.

# --- the router -------------------------------------------------------------
# Leave empty to try 192.168.1.1, 192.168.8.1, 192.168.0.1 ... in order.
MODEM_URL=
# Orange Airbox, SFR pocket routers and most ISP-branded Huawei firmware use
# admin/admin. Change it if you set your own on the router's web page.
MODEM_USER=admin
MODEM_PASSWORD=admin

# --- the service ------------------------------------------------------------
# Inside Docker with network_mode: host, 0.0.0.0 is fine on a trusted LAN.
BIND=0.0.0.0
PORT=8090

# --- first run --------------------------------------------------------------
# Leave empty and the admin password is generated and printed once in the log.
ADMIN_USER=admin
ADMIN_PASSWORD=

# --- data -------------------------------------------------------------------
# Docker: the compose file mounts a volume here. Bare metal: leave empty and
# hilinkd picks /var/lib/hilinkd (or ~/.local/share/hilinkd).
DATA_DIR=

# --- two-step verification --------------------------------------------------
OTP_LENGTH=6
OTP_TTL=300
OTP_MAX_ATTEMPTS=5
OTP_MAX_PER_HOUR=5
OTP_MESSAGE={code} : votre code de verification ({service}). Valable {minutes} min.

# --- notifications on inbound SMS -------------------------------------------
RELAY_ENABLED=false
NTFY_URL=
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# Any HTTP endpoint: receives {"from": "...", "text": "..."} as JSON.
WEBHOOK_URL=

# --- logs -------------------------------------------------------------------
LOG_LEVEL=info
