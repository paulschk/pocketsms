[Unit]
Description=hilinkd bring-up: make the 4G router reachable
Documentation=https://github.com/CHANGE-ME/hilinkd
After=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/hilinkd/scripts/bringup.sh
# A failure must not stop the gateway: hilinkd retries the router on demand.
SuccessExitStatus=0 1

[Install]
WantedBy=multi-user.target
